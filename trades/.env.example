# Alpaca paper-trading credentials. Never commit a real .env file.
APCA_API_KEY_ID=your_alpaca_paper_api_key_id
APCA_API_SECRET_KEY=your_alpaca_paper_api_secret_key
APCA_API_TRADING_BASE_URL=https://paper-api.alpaca.markets
APCA_API_DATA_BASE_URL=https://data.alpaca.markets

# Safety: leave false until you have reviewed dry-run logs.
ALPACA_ENABLE_TRADING=false

# Strategy/execution settings
DRAWDOWN_DB_PATH=./drawdown_analyzer.db
ALPACA_STATE_PATH=./trades/.alpaca_dip_dca_state.json
ALPACA_POLL_INTERVAL_SECONDS=1800
ALPACA_DCA_LOT_NOTIONAL=50
ALPACA_CASH_BUFFER=500
LOG_LEVEL=INFO
