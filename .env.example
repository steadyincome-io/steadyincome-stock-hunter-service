# Example environment variables
# Copy to .env and fill in your actual values

# Narrative / LLM provider settings
NARRATIVE_PROVIDER=openai
# Provider name to use for narrative calls.
# Supported values: openai, cohere, nim.
# Switch this value to change providers without touching code.
# Examples:
# - openai
# - cohere
# - nim

NARRATIVE_MODEL=gpt-4o-mini
# Model name to use for narrative summarization.
# Use a valid model name for the selected provider.
# Examples:
# - OpenAI: gpt-4o-mini
# - Cohere: command-a-03-2025, command-a-plus-05-2026, command-r-08-2024, command-r-plus-04-2024
# - NIM: meta/llama-3.1-8b-instruct, meta/llama-3.1-70b-instruct, meta/llama-3.3-70b-instruct, deepseek-ai/deepseek-r1, qwen/qwen3-32b, qwen/qwen2.5-coder-32b-instruct
# For NVIDIA NIM, the exact model ID depends on the deployment. Query /v1/models on the running NIM to get the exact value.

NARRATIVE_FALLBACK_PROVIDER=nim
# Optional failover provider to use when the primary provider returns HTTP 429.
# Set to nim if you want the pipeline to automatically switch to NIM during Cohere rate-limit errors.
# Leave blank to disable failover.

NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct
# Model name to use when NARRATIVE_PROVIDER=nim or when failover switches to NIM.
# Replace this with the exact model ID exposed by your deployed NIM instance.

NARRATIVE_FALLBACK_MODEL=
# Optional explicit model for the fallback provider.
# If left blank, the code uses the provider-specific model variable above.

NARRATIVE_TEMPERATURE=0.0
# Output randomness. 0.0 is deterministic; higher values allow more variation.
# Typical range: 0.0 to 1.0.

NARRATIVE_MAX_TOKENS=800
# Maximum tokens allowed in each LLM response. Must be a positive integer.

NARRATIVE_MAX_RPS=0.2
# Maximum narrative API requests per second.
# Use 0 to disable throttling, or a smaller value to slow down calls.
# Example: 0.2 means one call every 5 seconds.
# Recommended starting points:
# - openai: 1.0
# - cohere: 0.2
# - nim: 0.5

# Primary LLM credentials
OPENAI_API_KEY=your_openai_api_key_here

# Future provider placeholders
COHERE_API_KEY=your_cohere_api_key_here
COHERE_API_BASE=https://api.cohere.ai
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_NIM_API_BASE=https://integrate.api.nvidia.com/v1
# Optional: other LLM providers
# ANTHROPIC_API_KEY=your_anthropic_key
# HF_API_KEY=your_huggingface_key
