# Example environment variables
# Copy to .env and fill in your actual values

# Narrative / LLM provider settings
# -----------------------------------------------------------------------
# Two providers are actually live: GEMINI (primary -- every narrative call:
# risk_factors/mda/legal/buybacks/liquidity/comprehensive, plus concentration-
# risk and news-sentiment scoring) and NIM (fallback only, used when Gemini
# hits a transient error -- timeout, HTTP 429/5xx, or NIM's own "DEGRADED
# function cannot be invoked"). Cohere/OpenAI routing still exists in code
# (ai_narrative.py) if you want to switch later -- see the commented-out
# block at the bottom for the env vars that would need real values.

NARRATIVE_PROVIDER=gemini
NARRATIVE_FALLBACK_PROVIDER=nim

NARRATIVE_CONCURRENCY=1
# How many filings' LLM narrative calls run in flight at once during Step 1b
# (sec_financials_worker.sync_10k_10q_financials). Default 1 = old fully
# sequential behavior. The real bottleneck is per-call model latency
# (10-35s observed), not GEMINI_MAX_RPS -- the throttle already keeps total
# request rate under quota across threads, so raising this (e.g. 3-5) is what
# actually cuts wall-clock time for a full-universe run.

# --- Gemini (primary) ----------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemma-4-31b-it
# gemma-4-31b-it chosen over gemini-2.0-flash: this account's free tier had
# 0/0 quota for gemini-2.0-flash but real quota (30 RPM / 14.4K RPD) here --
# check your own account's actual rate-limit page before assuming any
# specific model has quota.
GEMINI_MAX_RPS=0.2
# Requests/sec for ALL Gemini traffic combined (narrative generation +
# concentration-risk + news-sentiment scoring share this one limit -- same
# upstream quota). Confirmed real ceiling is 30 RPM (0.5 rps); 0.4 leaves
# headroom.

# --- NIM (fallback only) --------------------------------------------------
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_NIM_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct
# Replace with the exact model ID exposed by your deployed NIM instance --
# query /v1/models on the running NIM to get the exact value.

# --- Shared knobs (apply whenever the fallback provider is actually invoked) ---
NARRATIVE_TEMPERATURE=0.0
# Output randomness. 0.0 is deterministic; higher values allow more variation.
NARRATIVE_MAX_TOKENS=800
# Max tokens per response for the fallback provider. Gemini uses
# GEMINI_MAX_TOKENS instead (default 4000 -- thinking-capable Gemini/Gemma
# models spend a large non-optional chunk of the budget on an internal
# reasoning trace before the real answer).
NARRATIVE_MAX_RPS=0.2
# Requests/sec for the fallback provider. Does NOT apply to gemini -- see
# GEMINI_MAX_RPS above.

# --- Not currently used -- kept for reference if you switch providers later ---
# OPENAI_API_KEY=your_openai_api_key_here
# COHERE_API_KEY=your_cohere_api_key_here
# COHERE_API_BASE=https://api.cohere.ai
# ANTHROPIC_API_KEY=your_anthropic_key
# HF_API_KEY=your_huggingface_key

# Alpaca (historical options data -- for verifying real historical option
# prices/implied-move data, e.g. for the earnings-reaction screener backtest;
# not yet wired into any pipeline code, this is just for manual testing).
# Exact env var names/header names confirmed against Alpaca's own docs
# (https://docs.alpaca.markets/reference/optionbars) -- their SDKs
# (alpaca-py, alpaca-trade-api) read these same names by default.
APCA_API_KEY_ID=your_alpaca_api_key_id_here
APCA_API_SECRET_KEY=your_alpaca_api_secret_key_here
# Market data API base URL (this is the DATA endpoint, separate from the
# trading API's base URL -- https://paper-api.alpaca.markets or
# https://api.alpaca.markets -- which isn't needed for historical data only).
APCA_API_BASE_URL=https://data.alpaca.markets
# The free "Indicative" tier works for this -- trades are delayed 15 minutes,
# which only matters for live trading, not for pulling historical bars.
# Confirmed via Alpaca's docs: historical options data only goes back to
# February 2024 (~20 months as of this writing), not further -- worth
# knowing before assuming a longer backtest window is available.
