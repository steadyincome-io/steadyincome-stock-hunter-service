# Secrets -- never commit real credentials
.env
.env.*
!.env.example

# Virtual environments
venv/
.venv/
env/
ENV/

# Python bytecode / caches
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Generated data (regenerated by the pipeline, not source)
drawdown_analyzer.db
drawdown_analyzer.db.bak
*.db
*.sqlite
*.sqlite3
cache/

# UI dev server pid/log (scripts/ui_start.sh, scripts/ui_stop.sh)
.ui.pid
.ui.log

# OS/editor cruft
.DS_Store
.vscode/
.idea/

# Logs
*.log

# Terraform (infra/terraform) -- state lives in the remote GCS backend, never
# locally or in git; .terraform.lock.hcl IS committed (dependency pinning)
infra/terraform/.terraform/
infra/terraform/.build/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.backup
infra/terraform/*.tfplan
